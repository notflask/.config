#!/bin/bash
# Erzeugt von matugen (templates-macos/bordersrc) – hier nichts ändern.
# JankyBorders: kräftiger als in Hyprland, damit man das aktive Fenster
# auf einen Blick sieht (aktiv primary deckend, sonst eine deutliche Kante).
# borders liest die Datei beim Start; läuft es schon, übernimmt es die
# Werte, wenn die Datei erneut ausgeführt wird (theme.sh).
options=(
	style=round
	width=4.0
	hidpi=on
	active_color=0xff{{colors.primary.default.hex_stripped}}
	inactive_color=<* if {{ is_dark_mode }} *>0x50ffffff<* else *>0x40000000<* endif *>
)
borders "${options[@]}"
