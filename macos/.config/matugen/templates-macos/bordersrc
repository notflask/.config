#!/bin/bash
# Erzeugt von matugen (templates-macos/bordersrc) – hier nichts ändern.
# JankyBorders: aktiv 5 px in der Quellfarbe des Wallpapers (primary ist
# bei scheme-neutral fast grau), inaktiv die Glaskante. borders liest die Datei beim
# Start; läuft es schon, übernimmt es die Werte, wenn die Datei erneut
# ausgeführt wird (theme.sh).
options=(
	style=round
	width=5.0
	hidpi=on
	active_color=0xff{{colors.source_color.default.hex_stripped}}
	inactive_color=<* if {{ is_dark_mode }} *>0x26ffffff<* else *>0x1f000000<* endif *>
)
borders "${options[@]}"
