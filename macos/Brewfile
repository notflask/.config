# Browser (Theme aus matugen: ~/.local/share/helium-theme, einmal laden)
cask "helium-browser"
# Starter, Zwischenablage-Verlauf
cask "raycast"
# Caps Lock als AeroSpace-Mod (⌃⌥), allein getippt Escape
