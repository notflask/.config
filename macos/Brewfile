# macOS-Programme: brew bundle --file ~/dotfiles/macos/Brewfile (macos/install.sh)
# Fremd-Taps: nur die einzelnen Pakete vertrauen, nicht ganze Taps
tap "nikitabobko/tap", trusted: { cask: "aerospace" }
