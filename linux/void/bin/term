#!/bin/sh
# Terminal im minimalen Stil (Super+T, Wegwerf-Terminal, Menüs): Ghostty
# nur mit ~/.config/ghostty/void.ghostty – Farben des Wallpapers, deckend,
# ohne Blur. Unter NixOS startet Ghostty direkt mit config.ghostty.
exec ghostty --config-default-files=false \
  --config-file="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/void.ghostty" "$@"
