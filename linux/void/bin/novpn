#!/bin/sh
# novpn BEFEHL [ARG...] – startet BEFEHL samt Kindprozessen am VPN vorbei
# (auch an Kill-Switch und Sperre), z. B. in Steam als Startoption:
#   novpn gaming-mode %command%
# Verschiebt sich selbst in die cgroup novpn (novpn-join per sudo ohne
# Passwort) und wird dann zu BEFEHL – alles darunter erbt die cgroup.
# Klappt das nicht, läuft das Programm eben durchs VPN.
if [ $# -eq 0 ]; then
  echo "novpn BEFEHL [ARG...]   startet BEFEHL am VPN vorbei" >&2
  exit 2
fi
sudo -n /usr/local/sbin/novpn-join $$ ||
  echo "novpn: Regel nicht gesetzt, $1 läuft durchs VPN" >&2
exec "$@"
