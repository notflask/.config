#!/bin/sh
# MangoWC starten (ly → /etc/ly/sessions/mango.desktop → mango-session). Entspricht unter
# NixOS den Sitzungsvariablen aus desktop.nix, nvidia.nix und theme.nix.
# Log der Sitzung: ~/.local/state/mango.log (vorige: mango.log.old)

# Rendern auf der RTX 4060; der interne Bildschirm hängt an der Iris Xe
# und bekommt das Bild von der NVIDIA kopiert (feste Namen: udev/rules.d)
export WLR_DRM_DEVICES=/dev/dri/nvidia-dgpu:/dev/dri/intel-igpu

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=mango
export XDG_CURRENT_DESKTOP=mango

# Videodekodierung (Firefox) auf derselben GPU wie der Desktop.
# nvidia-vaapi-driver braucht Firefox ohne RDD-Sandbox für den Decoder.
export LIBVA_DRIVER_NAME=nvidia
export NVD_BACKEND=direct
export MOZ_DISABLE_RDD_SANDBOX=1

# Electron-Apps (Discord, Claude …), Warp und Qt nativ unter Wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
export WARP_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM="wayland;xcb"
# Qt-Apps nutzen Farben, Icons und Terminal aus ~/.config/kdeglobals (matugen)
export QT_QPA_PLATFORMTHEME=kde
export XCURSOR_THEME=macOS
export XCURSOR_SIZE=24

# ~/.local/bin (uv python, claude, pipx-Programme) zuerst
export PATH="$HOME/.local/bin:$PATH"

state=${XDG_STATE_HOME:-$HOME/.local/state}
mkdir -p "$state"
[ -f "$state/mango.log" ] && mv -f "$state/mango.log" "$state/mango.log.old"
exec dbus-run-session mango >"$state/mango.log" 2>&1
