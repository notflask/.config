# wheel darf alles mit Passwort (wie NixOS)
%wheel ALL=(ALL:ALL) ALL

# VPN an/aus und Sperre ohne Passwort – für die Taskleiste und `vpn`
# (vpn.nix: Polkit-Regel für die systemd-Units)
%wheel ALL=(root) NOPASSWD: /usr/bin/sv up wg-quick-wg0, /usr/bin/sv down wg-quick-wg0, /usr/bin/sv restart wg-quick-wg0
%wheel ALL=(root) NOPASSWD: /usr/bin/sv up vpn-lock, /usr/bin/sv down vpn-lock

# Split-Tunneling: Programm am VPN vorbei (novpn), Ziele bearbeiten (vpn-split)
%wheel ALL=(root) NOPASSWD: /usr/local/sbin/novpn-join, /usr/local/sbin/vpn-bypass-edit
