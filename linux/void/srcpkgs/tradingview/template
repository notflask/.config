# Template file for 'tradingview'
# TradingView-Desktop-App – für Linux nur als Snap (wie in nixpkgs). Das
# Snap enthält die Electron-App samt einiger alter Bibliotheken.
# Neue Version: update-sources.sh
pkgname=tradingview
version=3.4.1
revision=1
_snaprev=74
archs="x86_64"
hostmakedepends="squashfs-tools"
depends="gtk+3 nss alsa-lib libnotify libsecret xdg-utils"
short_desc="TradingView desktop app (from the official snap)"
maintainer="flask <skyba@tutamail.com>"
license="custom:Proprietary"
homepage="https://www.tradingview.com/desktop/"
distfiles="https://api.snapcraft.io/api/v1/snaps/download/nJdITJ6ZJxdvfu8Ch7n5kH5P99ClzBYV_${_snaprev}.snap>tradingview-${version}.snap"
checksum=7c355bf31609e17b57434048217530da6b3451ab536dbae681bc0d47d706f670
repository=nonfree
restricted=yes
nostrip=yes
nopie=yes
create_wrksrc=yes
skip_extraction="tradingview-${version}.snap"

do_extract() {
	unsquashfs -q -d "${wrksrc}/snap" "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${skip_extraction}"
}

do_install() {
	cd snap
	vinstall meta/gui/icon.png 644 usr/share/icons/hicolor/512x512/apps tradingview.png
	# Snap-Startskripte und die Laufzeit-Hüllen von Snap braucht es hier nicht
	rm -rf meta gnome-platform data-dir scripts command.sh desktop-*.sh
	vmkdir usr/lib/tradingview
	vcopy "*" usr/lib/tradingview
	vmkdir usr/bin
	cat >"${DESTDIR}/usr/bin/tradingview" <<-'SH'
	#!/bin/sh
	# Mitgebrachte Bibliotheken (Tray) nur, wenn das System sie nicht hat
	d=/usr/lib/tradingview
	export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$d/usr/lib/x86_64-linux-gnu:$d/lib/x86_64-linux-gnu"
	exec "$d/tradingview" "$@"
	SH
	chmod 755 "${DESTDIR}/usr/bin/tradingview"
	vmkdir usr/share/applications
	cat >"${DESTDIR}/usr/share/applications/tradingview.desktop" <<-'DESKTOP'
	[Desktop Entry]
	Type=Application
	Name=TradingView
	Comment=Charts und Märkte
	Exec=tradingview %U
	Icon=tradingview
	StartupWMClass=TradingView
	MimeType=x-scheme-handler/tradingview;
	Categories=Finance;
	DESKTOP
}
