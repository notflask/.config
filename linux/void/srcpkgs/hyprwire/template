# Template file for 'hyprwire'
# Hyprland-Baustein, selbst gebaut (Void hat ihn nicht oder zu alt), siehe hyprland/template
pkgname=hyprwire
version=0.3.1
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config perl"
makedepends="hyprutils-devel libffi-devel pugixml-devel"
short_desc="Fast and consistent wire protocol for IPC"
maintainer="flask <skyba@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprwire"
distfiles="https://github.com/hyprwm/hyprwire/archive/refs/tags/v${version}.tar.gz>hyprwire-${version}.tar.gz"
checksum=92a673d40ae6a7d66fbcd0a34ec071e026e17eaeeb0040c3375e4b2a80dba737

# Void hat GCC 14, hyprwire nutzt vector::append_range (erst ab GCC 15) –
# in das gleichwertige insert(end(), …) umschreiben
post_patch() {
	perl -pi -e 's/([\w.]+)\.append_range\((.*)\);/{ auto&& _r = $2; $1.insert($1.end(), std::begin(_r), std::end(_r)); }/' \
		$(grep -rl append_range src)
}

post_install() {
	vlicense LICENSE
}

hyprwire-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
