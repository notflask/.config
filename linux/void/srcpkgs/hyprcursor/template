# Template file for 'hyprcursor'
# Hyprland-Baustein, selbst gebaut (Void hat ihn nicht oder zu alt), siehe hyprland/template
pkgname=hyprcursor
version=0.1.13
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config"
makedepends="hyprlang-devel libzip-devel cairo-devel librsvg-devel tomlplusplus-devel"
short_desc="Hyprland cursor format, library and utilities"
maintainer="flask <skyba@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/hyprcursor"
distfiles="https://github.com/hyprwm/hyprcursor/archive/refs/tags/v${version}.tar.gz>hyprcursor-${version}.tar.gz"
checksum=82af8b2ce27242ffdd6baebaa71b3f6c8665dc25c52bfcfccc16912622896af8

post_install() {
	vlicense LICENSE
}

hyprcursor-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprlang-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
