# Template file for 'font-apple-color-emoji'
# Apple Color Emoji (macOS 26) als Linux-taugliche TTF, gebaut von
# samuelngs/apple-emoji-ttf. Nicht von Apple lizenziert – nur für den
# privaten Gebrauch (wie linux/nix/pkgs/apple-emoji).
pkgname=font-apple-color-emoji
version=26.20260722
revision=1
_tag=macos-26-20260722-484daf4e
depends="font-util"
short_desc="Apple Color Emoji font for Linux"
maintainer="flask <skyba@tutamail.com>"
license="custom:Proprietary"
homepage="https://github.com/samuelngs/apple-emoji-ttf"
distfiles="${homepage}/releases/download/${_tag}/AppleColorEmoji-Linux.ttf"
checksum=e37c7af6265ac4a0af6d57bc65e86109a776d9966e8343334557f63da482516f
restricted=yes
font_dirs="/usr/share/fonts/TTF"
skip_extraction="AppleColorEmoji-Linux.ttf"

do_install() {
	vinstall "${XBPS_SRCDISTDIR}/${pkgname}-${version}/AppleColorEmoji-Linux.ttf" 644 \
		usr/share/fonts/TTF AppleColorEmoji.ttf
}
