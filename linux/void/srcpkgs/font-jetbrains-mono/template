# Template file for 'font-jetbrains-mono'
# JetBrains Mono (Ghostty, Monospace-Standard) und die Nerd-Font-Variante
# „JetBrainsMono Nerd Font“ mit Icons – Void hat nur alle Nerd Fonts auf
# einmal (mehrere GB). Wie fonts.nix.
pkgname=font-jetbrains-mono
version=2.304
revision=1
_nerd=3.5.1
depends="font-util"
short_desc="JetBrains Mono typeface, plain and Nerd Font variant"
maintainer="flask <skyba@tutamail.com>"
license="OFL-1.1"
homepage="https://www.jetbrains.com/lp/mono/"
distfiles="https://github.com/JetBrains/JetBrainsMono/releases/download/v${version}/JetBrainsMono-${version}.zip
 https://github.com/ryanoasis/nerd-fonts/releases/download/v${_nerd}/JetBrainsMono.tar.xz"
checksum="6f6376c6ed2960ea8a963cd7387ec9d76e3f629125bc33d1fdcd7eb7012f7bbf
 04d5e8f903693f9dd13e16f867e994834e681eb3c72c0d337a770dcda09010cf"
create_wrksrc=yes
font_dirs="/usr/share/fonts/TTF"

do_install() {
	for f in fonts/ttf/*.ttf *NerdFont-*.ttf; do
		vinstall "$f" 644 usr/share/fonts/TTF
	done
	vlicense OFL.txt
}
