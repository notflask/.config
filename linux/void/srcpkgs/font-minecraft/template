# Template file for 'font-minecraft'
# Minecraftia (Spotify, Telegram) und Monocraft als Ersatz mit mehr Zeichen
# (Kyrillisch) – wie fonts.nix.
pkgname=font-minecraft
version=4.2.1
revision=1
depends="font-util"
short_desc="Minecraftia and Monocraft fonts"
maintainer="flask <skyba@tutamail.com>"
license="OFL-1.1, custom:Minecraftia"
homepage="https://github.com/IdreesInc/Monocraft"
distfiles="https://github.com/IdreesInc/Monocraft/releases/download/v${version}/Monocraft-ttf.zip
 https://fontlibrary.org/assets/downloads/minecraftia/71962a7e3d4a70435c030466a12f1d63/minecraftia.zip"
checksum="897faffbef8cc27fadd0d5aa51872ab5f908e22a89bb8fa5b191366025d503e0
 e62a253e34d6ea9bd12a431134a23e68015000a75861992418f906daaacd6c81"
create_wrksrc=yes
font_dirs="/usr/share/fonts/TTF"

do_install() {
	for f in Minecraftia.ttf Monocraft-ttf/weights/*.ttf; do
		vinstall "$f" 644 usr/share/fonts/TTF
	done
}
