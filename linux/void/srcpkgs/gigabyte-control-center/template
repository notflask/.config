# Template file for 'gigabyte-control-center'
# Gigabyte Control Center (github:notflask/gigabyte-control-center):
# Tastaturlicht, Lüfter, Leistungsmodi für den G5 KF über die
# tuxedo-drivers. Entspricht dem NixOS-Modul (control-center.nix), der
# Dienst steht in linux/void/sv. Neuer Stand: _commit ändern.
pkgname=gigabyte-control-center
version=0.1.0
revision=1
_commit=d0dc074726ba410bf70b06c77ec5acf16843c1ed
build_style=python3-pep517
hostmakedepends="git python3-setuptools python3-wheel"
depends="python3 python3-pyside6-widgets python3-pyside6-gui python3-pyside6-dbus
 python3-pyside6-network python3-pyside6-svg qt6-wayland tuxedo-drivers"
short_desc="Keyboard light, fan and power mode control for Gigabyte G5 laptops"
maintainer="flask <skyba@tutamail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/notflask/gigabyte-control-center"

do_fetch() {
	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	[ -d .git ] || git init -q
	git fetch -q --depth 1 "${homepage}.git" "${_commit}"
	git checkout -q FETCH_HEAD
}

post_install() {
	vinstall gigabyte-control-center.desktop 644 usr/share/applications
	# Symbol: der Lüfter in einem Grau, das auf hellen und dunklen Menüs passt
	vmkdir usr/share/icons/hicolor/scalable/apps
	vmkdir usr/share/icons/hicolor/symbolic/apps
	sed 's/#000000/#8e939e/' gbcc/data/gbcc.svg \
		>"${DESTDIR}/usr/share/icons/hicolor/scalable/apps/gigabyte-control-center.svg"
	sed 's/#000000/#2e3436/' gbcc/data/gbcc.svg \
		>"${DESTDIR}/usr/share/icons/hicolor/symbolic/apps/gigabyte-control-center-symbolic.svg"
}
