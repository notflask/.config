# Template file for 'aquamarine'
# Hyprland-Baustein, selbst gebaut (Void hat ihn nicht oder zu alt), siehe hyprland/template
pkgname=aquamarine
version=0.15.1
revision=1
build_style=cmake
configure_args="-DBUILD_TESTING=OFF"
hostmakedepends="pkg-config hyprwayland-scanner wayland-devel"
makedepends="hyprutils-devel libseat-devel libinput-devel wayland-devel wayland-protocols libdrm-devel libgbm-devel eudev-libudev-devel libdisplay-info-devel hwids pixman-devel libglvnd-devel"
short_desc="Very light linux rendering backend library"
maintainer="flask <skyba@tutamail.com>"
license="BSD-3-Clause"
homepage="https://github.com/hyprwm/aquamarine"
distfiles="https://github.com/hyprwm/aquamarine/archive/refs/tags/v${version}.tar.gz>aquamarine-${version}.tar.gz"
checksum=2f9de98c0bd1b7b1b09c576e390a2fef436449762fb334163c414f0c300296f2

post_install() {
	vlicense LICENSE
}

aquamarine-devel_package() {
	depends="${sourcepkg}>=${version}_${revision} hyprutils-devel libdrm-devel pixman-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/pkgconfig
		vmove "usr/lib/*.so"
	}
}
