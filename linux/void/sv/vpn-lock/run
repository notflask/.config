#!/bin/sh
# VPN-Sperre (vpn.nix: vpn-lock): ohne Tunnel kein Internet, auch nicht
# beim Booten (dort setzt sie schon core-services/90-g5.sh) oder nach
# `vpn down`. `vpn unlock` (sv down vpn-lock) hebt sie bis zum Neustart auf.
exec 2>&1
mkdir -p /run/vpn
# Ohne VPN-Config nicht sperren
if [ -e /etc/wireguard/wg0.conf ]; then
  /usr/local/sbin/vpn-lock on || exit 1
  touch /run/vpn/vpn-lock.up
fi
exec pause
