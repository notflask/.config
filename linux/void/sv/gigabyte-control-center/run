#!/bin/sh
# Gigabyte Control Center (control-center.nix): Tastaturlicht, Lüfter,
# Leistungsmodi über die tuxedo-drivers. Firmware-Modus „Leistung“ beim
# Start, bis im Tray ein anderer gewählt wird (der bleibt gespeichert).
# Hört der Dienst auf, gehen die Lüfter zurück in den Automatikmodus.
exec 2>&1
# braucht das Modul tuxedo_io aus tuxedo-drivers (DKMS)
[ -e /dev/tuxedo_io ] || modprobe tuxedo_io 2>/dev/null
if [ ! -e /dev/tuxedo_io ]; then
  echo "gigabyte-control-center: /dev/tuxedo_io fehlt (tuxedo-drivers für $(uname -r) gebaut? sudo dkms status) – Dienst aus"
  exec sv down gigabyte-control-center
fi
mkdir -p /run/gigabyte-control-center /var/lib/gigabyte-control-center
exec gbccd --group users --default-profile performance
