{
    "include": ["~/.config/waybar/config-base"],
    
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["group/media"],
    "modules-right": ["group/systray", "network", "hyprland/language", "power-profiles-daemon", "custom/theme", "battery", "pulseaudio", "clock", "custom/vpn", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-de": "DE",
        "format-ru": "RU",
        "format-uk": "UA"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60
    }
}
