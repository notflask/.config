{
    "include": ["~/.config/waybar/config-base"],
    
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["group/media"],
    "modules-right": ["group/systray", "network", "hyprland/language", "custom/tuned", "battery", "pulseaudio", "clock", "custom/vpn", "custom/power"],

    "hyprland/workspaces": {
        "format": "{name}"
    },

    "hyprland/language": {
        "format": "<b>{}</b>",
        "format-en": "us",
        "format-de": "de",
        "format-ru": "ru",
        "format-uk": "ua"
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 60
    }
}
