{
    "include": ["~/.config/waybar/config-base"],
    
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["group/media"],
    "modules-right": ["group/systray", "network", "niri/language", "power-profiles-daemon", "custom/theme", "battery", "pulseaudio", "clock", "custom/vpn", "custom/power"],

    "niri/workspaces": {
        "format": "{value}"
    },

    "niri/language": {
        "format": "{}",
        "format-en": "US",
        "format-de": "DE",
        "format-ru": "RU",
        "format-uk": "UA"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60
    }
}
