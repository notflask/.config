{
    "include": ["~/.config/waybar/config-base"],
    
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": [],
    "modules-right": ["group/systray", "network", "niri/language", "custom/tuned", "battery", "pulseaudio", "clock", "custom/vpn", "custom/power"],

    "niri/workspaces": {
        "format": "{value}"
    },

    "niri/language": {
        "format": "<b>{}</b>",
        "format-en": "us",
        "format-de": "de",
        "format-ru": "ru",
        "format-uk": "ua"
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 60
    }
}
