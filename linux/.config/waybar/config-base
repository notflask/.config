{
    "layer": "top",
    "position": "top",
    "height": 34,
    // schwebend (Liquid Glass): Abstand zum Bildschirmrand
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    // Icons: alle aus einem Satz (Material Design, Symbols Nerd Font), etwas
    // größer als der Text, damit sie gleich groß wirken
    "network": {
        "format-wifi": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>{icon}</span>",
        "format-ethernet": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰈀</span>",
        "format-disconnected": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰤮</span>",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "<b>{essid}</b>  {signalStrength}%\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "<b>Kabel</b>  {ifname}\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Keine Verbindung",
        "interval": 5
    },

    "battery": {
        "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>{icon}</span>  {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰂄</span>  {capacity}%",
        "format-plugged": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰚥</span>  {capacity}%",
        "tooltip-format": "{timeTo}\n{power:.1f} W",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "pulseaudio": {
        "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>{icon}</span>  {volume}%",
        "format-muted": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰝟</span> stumm",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰥔</span>  {:%H:%M}",
        "format-alt": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰃭</span>  {:%d.%m.%Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>",
        "on-click": "toggle-format"
    },

    "custom/power": {
       "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰐥</span>",
       "on-click": "~/.config/wlogout/launch.sh",
       "tooltip": false
    },

    // Tray wie unter Windows: nur ein Pfeil, Klick klappt die Icons aus
    "group/systray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 250,
            "transition-left-to-right": false,
            "click-to-reveal": true,
            "children-class": "tray-child"
        },
        "modules": ["custom/tray-toggle", "tray"]
    },

    "custom/tray-toggle": {
        "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>󰅃</span>",
        "tooltip-format": "Weitere Symbole",
        "tooltip": true
    },

    "tray": {
        "icon-size": 22,
        "spacing": 12,
        "show-passive-items": true,
        "reverse-direction": false,
        "smooth-scrolling-threshold": 1.0,
        "tooltip": true
    },

    // Medien: Cover, Titel, Steuerung (scripts/media.sh, playerctl)
    // Wird komplett ausgeblendet, wenn kein Player läuft.
    "group/media": {
        "orientation": "inherit",
        "modules": ["image#cover", "custom/media", "custom/media-prev", "custom/media-play", "custom/media-next"]
    },

    "image#cover": {
        "exec": "~/.config/waybar/scripts/media.sh cover",
        "size": 22,
        "interval": 3600, // ohne interval hängt Waybar 0.15 in einer Update-Schleife
        "signal": 9,
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/media": {
        "exec": "~/.config/waybar/scripts/media.sh",
        "return-type": "json",
        "escape": false,
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl previous",
        "on-scroll-down": "playerctl next",
        "smooth-scrolling-threshold": 5
    },

    "custom/media-prev": {
        "exec": "~/.config/waybar/scripts/media.sh button prev",
        "return-type": "json",
        "on-click": "playerctl previous"
    },

    "custom/media-play": {
        "exec": "~/.config/waybar/scripts/media.sh button play",
        "return-type": "json",
        "on-click": "playerctl play-pause"
    },

    "custom/media-next": {
        "exec": "~/.config/waybar/scripts/media.sh button next",
        "return-type": "json",
        "on-click": "playerctl next"
    },

    "custom/vpn": {
        "exec": "~/.config/waybar/scripts/vpn.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/vpn.sh toggle"
    },

    "custom/tuned": {
        "format": "<span font_family='Symbols Nerd Font' size='13pt' rise='-1pt'>{}</span>",
        "exec": "case $(powerprofilesctl get) in performance) echo 󰓅 ;; power-saver) echo 󰾆 ;; *) echo 󰾅 ;; esac",
        "interval": 2,
        "tooltip": false,
        "on-click": "case $(powerprofilesctl get) in performance) powerprofilesctl set balanced ;; balanced) powerprofilesctl set power-saver ;; *) powerprofilesctl set performance ;; esac"
    }
}
