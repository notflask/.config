// Erzeugt von matugen (templates/rofi-colors.rasi) – hier nichts ändern
* {
    glass:     #2c292780;
    fg:        #e8e1dde6;
    fg-dim:    #ccc5c2cc;
    fg-faint:  #ccc5c280;
    selection: #e8e1dd29;
    // Suchkapsel: leicht abgesetzte Fläche auf dem Glas
    pill:      #ffffff17;
    // Akzent aus dem Hintergrundbild (Textcursor)
    accent:    #dac2ac;
    rim:       #ffffff40;
    // flat.rasi (Void/MangoWC): deckende Fläche und Rahmen
    bg:        #151311;
    border-c:  #dac2ac;
    divider:   #ffffff1f;
}
