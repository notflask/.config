// Erzeugt von matugen (templates/rofi-colors.rasi) – hier nichts ändern
* {
    glass:     #2a2a2a80;
    fg:        #e2e2e2e6;
    fg-dim:    #c6c6c6cc;
    fg-faint:  #c6c6c680;
    selection: #e2e2e229;
    // Suchkapsel: leicht abgesetzte Fläche auf dem Glas
    pill:      #ffffff17;
    // Akzent aus dem Hintergrundbild (Textcursor)
    accent:    #ffffff;
    rim:       #ffffff40;
    // flat.rasi: deckende Fläche und Rahmen
    bg:        #131313;
    border-c:  #ffffff;
    // soft.rasi (Stile islands/frame): Inselfläche, Auswahl als Kapsel
    soft-bg:   #1f1f1f;
    soft-pill: #353535;
    soft-rim:  #474747;
    soft-sel:  #474747;
    soft-sel-fg: #e2e2e2;
    soft-acc-fg: #1b1b1b;
    soft-key:  #2a2a2a;
    divider:   #ffffff1f;
}
