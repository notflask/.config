// Erzeugt von matugen (templates/rofi-colors.rasi) – hier nichts ändern
* {
    glass:     #eee7e380;
    fg:        #1d1b19e6;
    fg-dim:    #494643cc;
    fg-faint:  #49464380;
    selection: #1d1b1929;
    // Suchkapsel: leicht abgesetzte Fläche auf dem Glas
    pill:      #0000000d;
    // Akzent aus dem Hintergrundbild (Textcursor)
    accent:    #6c5c48;
    rim:       #00000024;
    // flat.rasi: deckende Fläche und Rahmen
    bg:        #fff8f4;
    border-c:  #6c5c48;
    // soft.rasi (Stile islands/frame): Inselfläche, Auswahl als Kapsel
    soft-bg:   #f3ede8;
    soft-pill: #e8e1dd;
    soft-rim:  #cbc5c1;
    soft-sel:  #f0e0d0;
    soft-sel-fg: #221a10;
    soft-acc-fg: #ffffff;
    soft-key:  #eee7e3;
    divider:   #00000014;
}
