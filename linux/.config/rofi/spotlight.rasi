// macOS Tahoe Spotlight: eine Glasfläche mit Kapsel-Suchfeld (voll gerundet)
// und darunter weichen, ebenfalls kapselförmigen Treffern. Die Fläche wird
// mit den Treffern höher und schrumpft bei wenigen Treffern auf die Kapsel.
// Blur + Schatten machen Niri/Hyprland (layer-rule "rofi", gleicher Radius
// wie window unten). Auswahl-Radius = window-Radius − padding.
@import "~/.config/rofi/colors.rasi"

* {
    font: "Inter 13";
    background-color: transparent;
    text-color: @fg;
    spacing: 0;
}

window {
    // Oben verankert: das Suchfeld bleibt beim Tippen an seinem Platz
    location: north;
    anchor: north;
    y-offset: 22%;
    width: 640px;
    padding: 10px;
    border: 1px solid;
    border-color: @rim;
    border-radius: 36px;
    background-color: @glass;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    children: [ icon-search, entry ];
    spacing: 14px;
    padding: 16px 24px;
    border-radius: 100px;
    background-color: @pill;
}

icon-search {
    expand: false;
    // eigene Lupe: Symbol-Icons aus dem Theme kämen fast schwarz
    filename: "~/.config/rofi/search.svg";
    size: 22px;
    vertical-align: 0.5;
}

entry {
    font: "Inter Medium 18";
    placeholder: "Spotlight-Suche";
    placeholder-color: @fg-faint;
    cursor-color: @accent;
    vertical-align: 0.5;
}

listview {
    lines: 5;
    columns: 1;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
    // Abstand zur Kapsel wie zum Rand
    margin: 2px 0 0 0;
}

element {
    children: [ element-icon, element-text ];
    spacing: 14px;
    padding: 6px 14px;
    border-radius: 26px;
    cursor: pointer;
}

element normal.normal, element alternate.normal, element normal.active, element alternate.active {
    background-color: transparent;
}

element selected.normal, element selected.active {
    background-color: @selection;
}

element-icon {
    size: 40px;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    highlight: none;
    cursor: inherit;
}

// "Keine Treffer" usw.
message, error-message {
    padding: 10px 18px;
    border-radius: 22px;
    background-color: @pill;
}
