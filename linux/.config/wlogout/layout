{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Sperren",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "niri msg action quit --skip-confirmation",
    "text" : "Abmelden",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Standby",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Neustart",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Ausschalten",
    "keybind" : "p"
}
