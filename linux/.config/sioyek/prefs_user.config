# Sioyek: PDF-Betrachter für Typst-Notizen (nvim: <leader>co, siehe
# nvim/lua/plugins/typst.lua). Ändert sich die PDF (tinymist exportiert beim
# Speichern), lädt Sioyek sie selbst neu und bleibt an derselben Stelle.

# Ein Fenster für alles: weitere PDFs öffnen im bestehenden Sioyek
should_launch_new_window 0

# Dunkel zum Desktop (Umschalten: F8)
default_dark_mode 1
dark_mode_contrast 0.85
dark_mode_background_color 0.08 0.08 0.10

# Lesen: weiches Scrollen, Lesezeichen/Markierungen nach Position sortiert
smooth_scroll_mode 1
sort_bookmarks_by_location 1
check_for_updates_on_startup 0

# Schrift wie der Rest des Desktops
ui_font Inter
font_size 13
status_bar_font_size 12
