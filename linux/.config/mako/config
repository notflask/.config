# Erzeugt von matugen (templates/mako.ini) – hier nichts ändern
# Stil: Liquid Glass – halbdurchsichtig, Blur macht niri bzw. Hyprland (Regel "notifications")
font=Inter 11
width=380
height=160
# Rand außerhalb der Fläche (10 px), innen nur unten Abstand
# zwischen den Nachrichten – sonst zeichnet der Compositor den Rand mit weich
outer-margin=10
margin=0,0,10,0
padding=14,16
border-size=1
border-radius=20
icons=1
max-icon-size=56
icon-location=left
# Zuerst die von theme.sh umgefärbten Symbole, dann die normalen
icon-path=/home/flask/.cache/matugen/icons:/usr/share/icons/Papirus:/usr/share/icons/hicolor
default-timeout=5000
# Manche Apps (z. B. Screenshots) wollen "nie ausblenden" – ignorieren
ignore-timeout=1
max-visible=5
layer=overlay
anchor=top-right

background-color=#fff8f473
text-color=#1d1b19
border-color=#0000001f
progress-color=over #f5dfc6

format=<b>%s</b>\n<span color="#494643">%b</span>

[urgency=low]
border-color=#00000012

[urgency=critical]
border-color=#ba1a1a
default-timeout=0

[mode=do-not-disturb]
invisible=1
