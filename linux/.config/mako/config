# Erzeugt von matugen (templates/mako.ini) – hier nichts ändern
# Stil: Liquid Glass – halbdurchsichtig, Blur macht niri (layer-rule "notifications")
font=Inter 11
width=380
height=160
# Rand außerhalb der Fläche (10 wie der Waybar-Rand), innen nur unten Abstand
# zwischen den Nachrichten – sonst zeichnet niri den Rand mit weich
outer-margin=10
margin=0,0,10,0
padding=14,16
border-size=1
border-radius=20
icons=1
max-icon-size=56
icon-location=left
default-timeout=5000
# Manche Apps (z. B. niri-Screenshots) wollen "nie ausblenden" – ignorieren
ignore-timeout=1
max-visible=5
layer=overlay
anchor=top-right

background-color=#13131873
text-color=#e4e1e9
border-color=#ffffff30
progress-color=over #3a4379

format=<b>%s</b>\n<span color="#c7c5d0">%b</span>

[urgency=low]
border-color=#ffffff18

[urgency=critical]
border-color=#ffb4ab
default-timeout=0

[mode=do-not-disturb]
invisible=1
