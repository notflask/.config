# Erzeugt von matugen (templates/mako-flat.ini) – hier nichts ändern
# Minimaler Stil für Void/MangoWC (`wm autostart` startet mako damit):
# eckig, deckend, 1px Rahmen in der Akzentfarbe. Unter NixOS: config (Glas)
font=JetBrains Mono 10
width=360
height=160
outer-margin=12
margin=0,0,8,0
padding=10,12
border-size=1
border-radius=0
icons=1
max-icon-size=40
icon-location=left
default-timeout=5000
ignore-timeout=1
max-visible=5
layer=overlay
anchor=top-right

background-color=#151311
text-color=#e8e1dd
border-color=#dac2ac
progress-color=over #544433

format=<b>%s</b>\n<span color="#ccc5c2">%b</span>

[urgency=low]
border-color=#95908c

[urgency=critical]
border-color=#ffb4ab
default-timeout=0

[mode=do-not-disturb]
invisible=1
