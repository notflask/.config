# Erzeugt von matugen (templates/ghostty-theme) – hier nichts ändern.
# Ghostty unter Hyprland (Befehl `term`): Fläche, Schrift,
# Cursor und Auswahl aus dem Wallpaper, deckend und ohne Blur (minimaler
# Stil). Die Terminalfarben 1–15 bleiben fest, damit Programme lesbar
# bleiben: dunkel wie Vague (TTY), hell wie Solarized Osaka Light.
# Farbe 0 („schwarz“, z. B. Hintergrund von cmatrix) ist die Fläche selbst.
# Im Glas-Stil gilt weiter das Thema aus config.ghostty.
background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
selection-background = {{colors.primary_container.default.hex}}
selection-foreground = {{colors.on_primary_container.default.hex}}
background-opacity = 1
<* if {{ is_dark_mode }} *>
palette = 0={{colors.surface.default.hex}}
palette = 1=#d8647e
palette = 2=#7fa563
palette = 3=#f3be7c
palette = 4=#6e94b2
palette = 5=#bb9dbd
palette = 6=#aeaed1
palette = 7=#cdcdcd
palette = 8=#606079
palette = 9=#e08398
palette = 10=#99b782
palette = 11=#f5cb96
palette = 12=#8ba9c1
palette = 13=#c9b1ca
palette = 14=#bebeda
palette = 15=#d7d7d7
<* else *>
palette = 0={{colors.surface.default.hex}}
