# Erzeugt von matugen (templates/ghostty-theme) – hier nichts ändern.
# Ghostty (`term` und config.ghostty): Fläche, Schrift,
# Cursor und Auswahl aus dem Wallpaper, deckend und ohne Blur (minimaler
# Stil; config.ghostty setzt die Glas-Deckkraft darüber). Die Terminalfarben 1–7 und 9
# bleiben fest, damit Programme lesbar bleiben: dunkel wie Vague (TTY), hell
# wie Solarized Osaka Light.
# Farbe 0 („schwarz“, z. B. Hintergrund von cmatrix) ist dunkel die Fläche
# selbst, hell die Schrift (Claude Code schreibt Code im hellen ANSI-Theme in
# Farbe 0).
# 8 und 10–14 färben den Code in Claude Code (Theme dark-ansi/light-ansi)
# wie Emacs: Kommentare outline; Strings, Zahlen tertiary; Schlüsselwörter,
# Funktionen, Typen primary. Grün/Rot der Diffs setzt das Claude-Theme selbst.
background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
selection-background = {{colors.primary_container.default.hex}}
selection-foreground = {{colors.on_primary_container.default.hex}}
background-opacity = 1
<* if {{ is_dark_mode }} *>
palette = 0={{colors.surface.default.hex}}
palette = 1=#d8647e
palette = 2=#7fa563
palette = 3=#f3be7c
palette = 4=#6e94b2
palette = 5=#bb9dbd
palette = 6=#aeaed1
palette = 7=#cdcdcd
palette = 8={{colors.outline.default.hex}}
palette = 9=#e08398
palette = 10={{colors.tertiary.default.hex}}
palette = 11={{colors.primary.default.hex}}
palette = 12={{colors.tertiary.default.hex}}
palette = 13={{colors.primary.default.hex}}
palette = 14={{colors.primary.default.hex}}
palette = 15=#d7d7d7
<* else *>
palette = 0={{colors.on_surface.default.hex}}
palette = 1=#db302d
palette = 2=#849900
palette = 3=#b28500
palette = 4=#268bd3
palette = 5=#d23681
palette = 6=#29a298
palette = 7=#002c38
palette = 8={{colors.outline.default.hex}}
palette = 9=#b7211f
palette = 10={{colors.tertiary.default.hex}}
palette = 11={{colors.primary.default.hex}}
palette = 12={{colors.tertiary.default.hex}}
palette = 13={{colors.primary.default.hex}}
palette = 14={{colors.primary.default.hex}}
palette = 15=#001419
<* endif *>
