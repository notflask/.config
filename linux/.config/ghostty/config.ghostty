language = de
# Folgt hell/dunkel des Systems (theme.sh, Super+Shift+T);
# Eigene Themes in themes/: "Vague Black" = Vague mit schwarzem Hintergrund,
# "Matugen" (hell) wird von matugen aus dem Hintergrundbild erzeugt
theme = light:Matugen,dark:Vague Black
font-family = "JetBrains Mono"
font-family = "Apple Color Emoji"
font-size = 16
gtk-titlebar = false
window-padding-x = 8
window-padding-y = 8
background-blur = true
# Volles statt "light"-Hinting: bei Skalierung 1 sonst weiche, unscharfe Kanten
freetype-load-flags = no-light
