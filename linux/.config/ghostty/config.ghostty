language = de
# Systemfarben: themes/matugen (aus dem Wallpaper, hell/dunkel folgt dem
# System über theme.sh, Super+Shift+T) – wie Neovim (colors/matugen.lua).
# Deckend, ohne Glas-Transparenz.
theme = matugen
background-opacity = 1
font-family = "JetBrains Mono"
font-family = "Apple Color Emoji"
font-size = 14
gtk-titlebar = false
window-padding-x = 8
window-padding-y = 8
background-blur = false
# Volles statt "light"-Hinting: bei Skalierung 1 sonst weiche, unscharfe Kanten
freetype-load-flags = no-light
