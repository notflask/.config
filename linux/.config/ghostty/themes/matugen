# Erzeugt von matugen (templates/ghostty-theme) – hier nichts ändern.
# Ghostty unter Void/MangoWC (Befehl `term`, linux/void/bin): Fläche, Schrift,
# Cursor und Auswahl aus dem Wallpaper, deckend und ohne Blur (minimaler
# Stil). Die Terminalfarben 1–15 bleiben fest, damit Programme lesbar
# bleiben: dunkel wie Vague (TTY, theme.nix), hell wie Solarized Osaka Light.
# Farbe 0 („schwarz“, z. B. Hintergrund von cmatrix) ist die Fläche selbst.
# Unter NixOS gilt weiter das Thema aus config.ghostty.
background = #121413
foreground = #e3e2e1
cursor-color = #b8cbc4
cursor-text = #23342f
selection-background = #3a4a45
selection-foreground = #d4e7e0
background-opacity = 1
palette = 0=#121413
palette = 1=#d8647e
palette = 2=#7fa563
palette = 3=#f3be7c
palette = 4=#6e94b2
palette = 5=#bb9dbd
palette = 6=#aeaed1
palette = 7=#cdcdcd
palette = 8=#606079
palette = 9=#e08398
palette = 10=#99b782
palette = 11=#f5cb96
