#!/bin/bash
# Ziele am VPN vorbei auflösen. Eins pro Zeile in
# /var/lib/vpn-bypass/domains: Domains (alle 10 min neu aufgelöst, nur IPv4,
# sv/vpn-bypass-dst) oder IPv4-Adressen/-Netze.
set -euo pipefail
bypass_file=/var/lib/vpn-bypass/domains

# erst alles auflösen, dann die Kette in einem Rutsch ersetzen
hosts=()
if [ -f $bypass_file ]; then
  mapfile -t hosts < <(grep -v '^[[:space:]]*\(#\|$\)' $bypass_file || true)
fi
addrs=()
for host in "${hosts[@]}"; do
  if [[ $host =~ ^[0-9./]+$ ]]; then
    addrs+=("$host")
  else
    while read -r addr; do
      addrs+=("$addr")
    done < <(getent ahostsv4 "$host" | awk '{ print $1 }' | sort -u)
  fi
done
iptables -t mangle -F novpn-dst
for addr in "${addrs[@]}"; do
  iptables -t mangle -A novpn-dst -d "$addr" -j novpn-mark
done
