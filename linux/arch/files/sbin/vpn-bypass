#!/bin/sh
# Split-Tunneling: Pakete am VPN vorbei bekommen die
# Markierung der verschlüsselten WireGuard-Pakete (fwmark). Dann nimmt die
# Routing-Regel von wg-quick die normale Route, Kill-Switch und Sperre lassen
# sie durch. Die Absenderadresse wurde aber schon für wg0 gewählt –
# MASQUERADE setzt die richtige. Die Verbindung merkt sich die Umleitung
# (connmark), damit sie nicht reißt, wenn sich die Adressliste ändert.
#   novpn       Kette in mangle/OUTPUT: entscheidet pro Paket
#   novpn-app   Programme in der cgroup /sys/fs/cgroup/novpn (novpn-join)
#   novpn-dst   Ziele aus /var/lib/vpn-bypass/domains (vpn-bypass-dst)
#   novpn-mark  markiert Paket und Verbindung
set -eu
iface=wg0
mark=51820
connmark=0x10000/0x10000
cgroup=/sys/fs/cgroup/novpn

for ipt in iptables ip6tables; do
  while "$ipt" -t mangle -D OUTPUT -j novpn 2>/dev/null; do :; done
  while "$ipt" -t nat -D POSTROUTING ! -o $iface -m connmark --mark $connmark -j MASQUERADE 2>/dev/null; do :; done
  for chain in novpn novpn-app novpn-dst novpn-mark; do
    "$ipt" -t mangle -F $chain 2>/dev/null || true
  done
  for chain in novpn novpn-app novpn-dst novpn-mark; do
    "$ipt" -t mangle -X $chain 2>/dev/null || true
  done
done
[ "${1:-}" = on ] || exit 0

# Gemeinsame cgroup für alle Programme unter novpn (cgroup v2, rc.conf:
# CGROUP_MODE=unified). iptables löst den Pfad beim Anlegen der Regel auf.
mkdir -p $cgroup

for ipt in iptables ip6tables; do
  for chain in novpn novpn-app novpn-dst novpn-mark; do
    "$ipt" -t mangle -N $chain
  done
  "$ipt" -t mangle -A novpn-mark -j MARK --set-mark $mark
  "$ipt" -t mangle -A novpn-mark -j CONNMARK --set-xmark $connmark

  "$ipt" -t mangle -A novpn -o lo -j RETURN
  "$ipt" -t mangle -A novpn -m mark --mark $mark -j RETURN
  "$ipt" -t mangle -A novpn -m connmark --mark $connmark -j MARK --set-mark $mark
  "$ipt" -t mangle -A novpn -m mark --mark $mark -j RETURN
  "$ipt" -t mangle -A novpn -j novpn-app
  "$ipt" -t mangle -A novpn -j novpn-dst
  "$ipt" -t mangle -A OUTPUT -j novpn

  "$ipt" -t mangle -A novpn-app -m cgroup --path novpn -j novpn-mark
  "$ipt" -t nat -A POSTROUTING ! -o $iface -m connmark --mark $connmark -j MASQUERADE
done
