#!/bin/sh
# Zwischenablage-Verlauf (Super+Strg+V, wie Win+V): cliphist speichert jede
# Kopie (`wm autostart`), Rofi zeigt sie. Enter kopiert den Eintrag wieder,
# Shift+Entf löscht ihn aus dem Verlauf.
rc=0
sel=$(cliphist list | rofi -dmenu -i -p Zwischenablage -theme ~/.config/rofi/flat.rasi \
  -display-columns 2 \
  -kb-delete-entry "" -kb-custom-1 "Shift+Delete" \
  -mesg "Enter: kopieren · Shift+Entf: löschen") || rc=$?
case $rc in
  0) printf '%s' "$sel" | cliphist decode | wl-copy ;;
  10) printf '%s' "$sel" | cliphist delete ;;
esac
