#!/bin/sh
# WireGuard-Status für die Taskleiste: Endpoint und
# letzter Handshake, ohne Schlüssel. `wg show` braucht root – deshalb
# schreibt dieser Dienst die Werte alle 5 s in eine lesbare Datei.
exec 2>&1
file=/run/wg0-peer-info
while :; do
  if ip link show wg0 >/dev/null 2>&1; then
    {
      wg show wg0 endpoints | awk 'NR==1 {print "endpoint=" $2}'
      wg show wg0 latest-handshakes | awk 'NR==1 {print "handshake=" $2}'
    } >$file.tmp && mv $file.tmp $file
  else
    rm -f $file
  fi
  sleep 5
done
