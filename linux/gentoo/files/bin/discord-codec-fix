#!/usr/bin/env python3
"""Keep Discord's native OpenH264 decoder available across startup cleanup."""
import bz2
import hashlib
import json
import os
from pathlib import Path
import shutil
import struct
import sys
import tempfile
import urllib.request


CODEC = "libopenh264-2.5.1-linux64.7.so"
SHA256 = "d828a944d4d2bb64195ada89cf2cde9bc41733b1547d0788ef49fb8cb231b76f"
URL = f"https://ciscobinary.openh264.org/{CODEC}.bz2"
BEFORE = b'cleanupUnusedAssets(neededFileNames,openH264Path,"OpenH264")'
AFTER = b'cleanupUnusedAssets([...neededFileNames,exports.OPENH264_LIBRARY_FILE_NAME],openH264Path,"OpenH264")'


def unpack(raw):
    base = 8 + struct.unpack_from("<I", raw, 4)[0]
    size = struct.unpack_from("<I", raw, 12)[0]
    return json.loads(raw[16:16 + size]), base


def patch_archive(raw):
    header, base = unpack(raw)
    entry = header["files"]["mainScreenPreload.js"]
    start = base + int(entry["offset"])
    script = raw[start:start + entry["size"]]
    # Stop applying the workaround when upstream changes the native codec.
    if f'exports.OPENH264_LIBRARY_FILE_NAME="{CODEC}"'.encode() not in script:
        return None
    if AFTER in script:
        return raw
    if script.count(BEFORE) != 1:
        raise RuntimeError("Unknown Discord cleanup code; leaving it unchanged")
    script = script.replace(BEFORE, AFTER, 1)
    entry["offset"], entry["size"] = str(len(raw) - base), len(script)
    integrity = entry["integrity"]
    if integrity["algorithm"] != "SHA256":
        raise RuntimeError("Unknown ASAR integrity algorithm")
    integrity["hash"] = hashlib.sha256(script).hexdigest()
    block = integrity["blockSize"]
    integrity["blocks"] = [
        hashlib.sha256(script[i:i + block]).hexdigest()
        for i in range(0, len(script), block)
    ]
    encoded = json.dumps(header, separators=(",", ":"), ensure_ascii=False).encode()
    payload = struct.pack("<I", len(encoded)) + encoded + b"\0" * (-len(encoded) % 4)
    pickle = struct.pack("<I", len(payload)) + payload
    return struct.pack("<II", 4, len(pickle)) + pickle + raw[base:] + script


def atomic_write(path, data):
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        temporary = Path(stream.name)
        try:
            stream.write(data)
            stream.flush()
            temporary.chmod(0o644)
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def repair(core, cache):
    raw = core.read_bytes()
    patched = patch_archive(raw)
    if patched is None:
        return
    codec = cache / CODEC
    data = codec.read_bytes() if codec.exists() else b""
    if hashlib.sha256(data).hexdigest() != SHA256:
        with urllib.request.urlopen(URL, timeout=30) as response:
            data = bz2.decompress(response.read())
        if hashlib.sha256(data).hexdigest() != SHA256:
            raise RuntimeError("OpenH264 checksum mismatch; leaving Discord unchanged")
        cache.mkdir(parents=True, exist_ok=True)
        atomic_write(codec, data)
    if patched != raw:
        backup = core.with_name("core.asar.before-openh264-cleanup-fix")
        if backup.exists():
            raise RuntimeError("Existing Discord backup; refusing to overwrite it")
        shutil.copy2(core, backup)
        atomic_write(core, patched)
        print("Discord: retained native OpenH264 decoder during startup cleanup")


def main():
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "discord"
    version = json.loads(Path("/opt/discord/resources/build_info.json").read_text())["version"]
    if not version or any(c not in "0123456789." for c in version):
        raise RuntimeError("Invalid Discord version")
    core = config / version / "modules/discord_desktop_core/core.asar"
    if core.exists():
        repair(core, config / "discord_asset_cache/openh264")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"Discord codec repair: {error}", file=sys.stderr)
        sys.exit(1)
