#!/bin/sh
# Discord (mit Vencord) auf der richtigen GPU –: Hyprland rendert
# auf der NVIDIA und kann Bildpuffer der Iris Xe nicht importieren (Fenster
# bliebe schwarz); der Bildschirm-Stream kommt als DMA-BUF der NVIDIA. Discord
# zeichnet daher auf der NVIDIA und kodiert per NVENC. VA-API auf der Iris Xe.
export LIBVA_DRIVER_NAME=iHD
exec /opt/discord/Discord --render-node-override=/dev/dri/nvidia-render \
  --enable-gpu-rasterization "$@"
