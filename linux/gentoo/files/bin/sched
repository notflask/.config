#!/bin/sh
# sched [status|on|off|NAME]  – sched_ext-Scheduler (lavd, bpfland, rusty …)
conf=/etc/g5/scx.conf
set_conf() { sudo sed -i "s/^$1=.*/$1=$2/" "$conf"; }
case ${1:-status} in
  status)
    echo "aktiv:   $(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo 'Kernel (EEVDF)')"
    echo "Zustand: $(cat /sys/kernel/sched_ext/state 2>/dev/null)"
    grep -E '^(ENABLED|SCHED|ARGS)=' "$conf"
    [ -f /var/lib/g5-scx/disabled ] && cat /var/lib/g5-scx/disabled
    exit 0 ;;
  on) set_conf ENABLED yes ;;
  off) set_conf ENABLED no; sudo systemctl stop g5-scx; exit 0 ;;
  *) n=${1#scx_}; command -v "scx_$n" >/dev/null || { echo "scx_$n nicht installiert" >&2; exit 1; }
     set_conf SCHED "scx_$n"; set_conf ENABLED yes ;;
esac
sudo rm -f /var/lib/g5-scx/running
sudo systemctl reset-failed g5-scx 2>/dev/null
sudo systemctl restart g5-scx && sleep 2 && exec "$0" status
