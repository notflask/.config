[Unit]
Description=WireGuard-Tunnel wg0 mit Kill-Switch
ConditionPathExists=/etc/wireguard/wg0.conf
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/wg-quick up wg0
ExecStartPost=/usr/local/sbin/vpn-killswitch on wg0
ExecStartPost=/bin/sh -c 'mkdir -p /run/vpn && touch /run/vpn/wg-quick-wg0.up'
ExecStop=-/usr/local/sbin/vpn-killswitch off wg0
ExecStop=/usr/bin/wg-quick down wg0
ExecStopPost=/bin/rm -f /run/vpn/wg-quick-wg0.up
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
