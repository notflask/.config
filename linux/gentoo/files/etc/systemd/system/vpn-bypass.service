[Unit]
Description=Split-Tunneling: Ketten anlegen
DefaultDependencies=no
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/vpn-helper bypass on
ExecStop=/usr/local/sbin/vpn-helper bypass off

[Install]
WantedBy=multi-user.target
