# Feste Namen für die GPUs (cardN kann sich zwischen Boots ändern) –
# Hyprland wählt NVIDIA und Iris Xe (hyprland-session: AQ_DRM_DEVICES), Discord
# wählt seine GPU darüber
KERNEL=="card*", SUBSYSTEM=="drm", KERNELS=="0000:00:02.0", SYMLINK+="dri/intel-igpu"
KERNEL=="card*", SUBSYSTEM=="drm", KERNELS=="0000:01:00.0", SYMLINK+="dri/nvidia-dgpu"
KERNEL=="renderD*", SUBSYSTEM=="drm", KERNELS=="0000:01:00.0", SYMLINK+="dri/nvidia-render"
KERNEL=="renderD*", SUBSYSTEM=="drm", KERNELS=="0000:00:02.0", SYMLINK+="dri/intel-render"

# NTSYNC für alle Benutzer (Proton nutzt /dev/ntsync automatisch)
KERNEL=="ntsync", MODE="0666"

# Realtek-LAN: Energy Efficient Ethernet aus – das Aufwachen sorgt für
# Ping-Spitzen und bei manchen Routern für Link-Abbrüche
ACTION=="add", SUBSYSTEM=="net", DRIVERS=="r8169", RUN+="/usr/bin/ethtool --set-eee $name eee off"

# NVMe mit BFQ statt "none": nur BFQ beachtet I/O-Prioritäten. Steam läuft
# mit ionice niedrig (bin/steam) – große Downloads schreiben dann nur, wenn
# sonst niemand die Platte braucht, Firefox & Co. hängen nicht mehr
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", KERNEL=="nvme[0-9]*n[0-9]*", ATTR{queue/scheduler}="bfq"
