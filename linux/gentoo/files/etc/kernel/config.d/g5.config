# Gilt nur für lokal gebaute Kernel (make.conf: --usepkg-exclude gentoo-kernel)
# 1000 Hz: kürzere Zeitscheiben → gleichmäßigere Frametimes und Eingaben
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NTSYNC=m
# Kernel für genau diese CPU (Alder Lake) optimieren (-march=native)
CONFIG_X86_NATIVE_CPU=y
