# GTK-Vorgaben, auch für Flatpaks über das Einstellungs-Portal.
# theme.sh überschreibt Hell/Dunkel, Thema und Icons. Nach Änderungen:
# sudo dconf update
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus-Dark'
cursor-theme='macOS'
cursor-size=24
font-name='Noto Sans 10'
monospace-font-name='JetBrains Mono 10'
