#!/bin/bash
# Vencord in das (vom Paket verwaltete) Discord unter /opt/discord einbauen.
# Läuft nach jedem Discord-Update per pacman-Hook (90-g5-vencord.hook).
set -euo pipefail
version=v1.4.2
sha256=52642c8521a866ad241c10337144a4f513672c54b9c86a8169954785054c815d
cli=/var/cache/VencordInstallerCli-$version
[ -d /opt/discord ] || exit 0
[ -e /opt/discord/resources/_app.asar ] && exit 0
if [ ! -x "$cli" ]; then
  curl -fsSL -o "$cli.part" "https://github.com/Vendicated/VencordInstaller/releases/download/$version/VencordInstallerCli-Linux"
  if echo "$sha256  $cli.part" | sha256sum -c --quiet; then
    install -m 755 "$cli.part" "$cli"; rm -f "$cli.part"
  else
    rm -f "$cli.part"; echo "vencord-patch: Prüfsumme falsch" >&2; exit 0
  fi
fi
cd /tmp && "$cli" -install -location /opt/discord || echo "vencord-patch: fehlgeschlagen" >&2
exit 0
