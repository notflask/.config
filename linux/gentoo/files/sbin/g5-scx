#!/bin/bash
# sched_ext-Scheduler mit Absturzschutz (g5-scx.service)
conf=/etc/g5/scx.conf
state=/var/lib/g5-scx
ENABLED=no SCHED=scx_lavd ARGS=auto
# shellcheck source=/dev/null
[ -f "$conf" ] && . "$conf"
mkdir -p "$state"

case ${1:-start} in
  start)
    [ "$ENABLED" = yes ] || { echo "scx: aus ($conf)"; exit 0; }
    if [ -e "$state/running" ]; then
      sed -i 's/^ENABLED=.*/ENABLED=no/' "$conf"
      rm -f "$state/running"
      echo "$(date '+%F %T'): System lief mit $SCHED nicht sauber herunter – scx abgeschaltet" >"$state/disabled"
      echo "scx: letzter Start endete unsauber – abgeschaltet, Kernel-Scheduler bleibt (sched on)" >&2
      exit 0
    fi
    [ -e /sys/kernel/sched_ext/state ] || { echo "scx: Kernel ohne sched_ext" >&2; exit 0; }
    bin=$(command -v "$SCHED") || { echo "scx: $SCHED fehlt" >&2; exit 0; }
    args=()
    if [ "$ARGS" = auto ]; then
      [ "$SCHED" = scx_lavd ] && "$bin" --help 2>&1 | grep -q -- '--performance' && args=(--performance)
    elif [ -n "$ARGS" ]; then
      read -ra args <<<"$ARGS"
    fi
    rm -f "$state/disabled"
    touch "$state/running"; sync -f "$state/running"
    exec "$bin" "${args[@]}"
    ;;
  stopped)
    rm -f "$state/running"; sync -f "$state" 2>/dev/null || true
    ;;
esac
