#!/bin/bash
# Ziel zur Bypass-Liste hinzufügen/entfernen und gleich anwenden
#. Per sudo ohne Passwort
# (/etc/sudoers.d/g5-vpn), deshalb nur Domainnamen und IPv4-Adressen/-Netze.
set -euo pipefail
bypass_file=/var/lib/vpn-bypass/domains
action=${1:-} target=${2:-}
target=${target,,}
if ! [[ $target =~ ^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$ || $target =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]]; then
  echo "vpn-bypass-edit: ungültiges Ziel: $target" >&2
  exit 2
fi
install -d -m 755 "${bypass_file%/*}"
touch $bypass_file
chmod 644 $bypass_file
case $action in
  add) grep -qxF -- "$target" $bypass_file || echo "$target" >>$bypass_file ;;
  remove)
    grep -vxF -- "$target" $bypass_file >$bypass_file.tmp || true
    mv $bypass_file.tmp $bypass_file
    ;;
  *) echo "vpn-bypass-edit add|remove ZIEL" >&2; exit 2 ;;
esac
exec /usr/local/sbin/vpn-bypass-dst
